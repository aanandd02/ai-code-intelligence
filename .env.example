# ═══════════════════════════════════════════════════════════════════════
# AI Code Intelligence — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════
# TOTAL API COST = $0
# TOTAL CLOUD COST = $0
# Everything runs locally on your machine.
# ═══════════════════════════════════════════════════════════════════════

# ── Ollama (Local LLM) ──────────────────────────────────────────────
# Ollama runs natively on your host for GPU acceleration.
# Install from: https://ollama.ai
# Then: ollama pull codellama:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=codellama:7b
OLLAMA_TIMEOUT=120

# ── Embeddings ──────────────────────────────────────────────────────
# Uses Ollama for embeddings — no paid API needed.
# Pull the model: ollama pull nomic-embed-text
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# ── Qdrant Vector Database ─────────────────────────────────────────
# Runs via Docker Compose — no cloud account needed.
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ── Database ────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/code_intelligence.db

# ── Application ─────────────────────────────────────────────────────
APP_NAME=AI Code Intelligence
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# ── Context & Search ───────────────────────────────────────────────
MAX_CONTEXT_TOKENS=4096
SEARCH_TOP_K=10
AGENT_MAX_ITERATIONS=10

# ── Security ───────────────────────────────────────────────────────
# Leave empty to allow any valid local path.
# Set to comma-separated paths to restrict repo registration.
ALLOWED_REPO_BASE_PATHS=
MAX_FILE_SIZE_MB=10
MAX_REQUEST_SIZE_MB=50
